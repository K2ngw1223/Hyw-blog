{
  "name": "hyw-blog",
  "version": "1.0.0",
  "description": "Hyw-blog - 可自托管的开源个人博客系统模板，登录用户也可以发表文章",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --experimental-sqlite --no-warnings server.js",
    "dev": "node --experimental-sqlite --no-warnings --watch server.js",
    "deploy": "wrangler deploy",
    "dev:cf": "wrangler dev"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "highlight.js": "^11.10.0",
    "hono": "^4.13.1",
    "jsonwebtoken": "^9.0.2",
    "marked": "^12.0.2",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  }
}
